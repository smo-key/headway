{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Headway main window: native open/save dialogs plus read, write and watch of user-chosen workbook paths anywhere on disk (documents live in arbitrary folders, including OneDrive).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "updater:default",
    "process:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }, { "path": "/**" }, { "path": "$HOME/**" }]
    }
  ]
}
