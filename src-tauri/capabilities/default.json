{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Headway main window: native open/save dialogs plus read, write and watch of user-chosen workbook paths anywhere on disk (documents live in arbitrary folders, including OneDrive). Outbound HTTPS is allowed for the Jira sync (any host, so self-hosted sites work too).",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-is-maximized",
    "updater:default",
    "process:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://**"
        },
        {
          "url": "http://**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*:*/*"
        }
      ]
    },
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-stat",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "/**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    }
  ]
}
