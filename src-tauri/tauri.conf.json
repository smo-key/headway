{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Headway",
  "version": "1.0.3",
  "identifier": "dev.smokey.headway",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/copy-frontend.mjs",
    "beforeBuildCommand": "node scripts/copy-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Headway",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMyODY3MUVERjMxRUY5NkQKUldSdCtSN3o3WEdHd3A2VTFDTzVXMnNnWXY1Si91TEszT2c0QWI2RE1rODlTUW0xaTQwMkY4V3YK",
      "endpoints": [
        "https://github.com/smo-key/headway/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
