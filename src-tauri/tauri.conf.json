{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Headway",
  "version": "1.0.1",
  "identifier": "dev.smokey.headway",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/copy-frontend.mjs",
    "beforeBuildCommand": "node scripts/copy-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Headway",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
